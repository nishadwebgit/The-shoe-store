<Project>
  <!--
    Shared build settings for every project in the solution.
    The solution targets .NET 9 because that is the SDK installed on the development machine.
    To move to .NET 10 LTS: install the .NET 10 SDK, change TargetFramework to net10.0 and
    bump the Microsoft.* package versions from 9.0.* to 10.0.*.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
