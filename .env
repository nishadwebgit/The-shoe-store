# Shared defaults for every mode. Override locally in .env.local (not committed).

# false = use the Nishoes ASP.NET Core Web API (shoe-store-api); true = local mock data only.
VITE_USE_MOCK_SERVICES=false

# API base URL. "/api/v1" is proxied by the Vite dev server to VITE_API_PROXY_TARGET.
VITE_API_BASE_URL=/api/v1

# Where the dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:5080
