# Copy to .env.local to override the defaults in .env.

# Use the ASP.NET Core API (false) or run fully offline on mock data (true).
VITE_USE_MOCK_SERVICES=false

# Base URL used by the browser. Keep "/api/v1" in development (proxied by Vite).
# For a deployed API without a proxy, use the full URL, e.g. https://api.nishoes.lk/api/v1
VITE_API_BASE_URL=/api/v1

# Dev-server proxy target (where shoe-store-api is listening).
VITE_API_PROXY_TARGET=http://localhost:5080
